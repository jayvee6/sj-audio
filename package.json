{
  "name": "sj-audio",
  "version": "0.0.1",
  "description": "Cross-browser web audio capture + analysis library for music visualization. Exposes window.SJAudio.",
  "license": "MIT",
  "author": "Joe Villarreal <joeyvillarreal@me.com>",
  "main": "dist/sj-audio.cjs.js",
  "module": "dist/sj-audio.esm.js",
  "unpkg": "dist/sj-audio.umd.js",
  "jsdelivr": "dist/sj-audio.umd.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "echo \"tests not wired yet — see chunk 3\" && exit 1"
  },
  "keywords": [
    "web-audio",
    "audio-analysis",
    "fft",
    "beat-detection",
    "music-visualization",
    "getusermedia",
    "getdisplaymedia"
  ],
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.60.2",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1",
    "typescript": "~5.6.0"
  }
}
